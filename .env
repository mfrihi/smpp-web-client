# SMSC Connection Defaults (can be overridden in UI)
SMPP_HOST=127.0.0.1
SMPP_PORT=2775
SMPP_SYSTEM_ID=your_username
SMPP_PASSWORD=your_password
SMPP_SYSTEM_TYPE=
SMPP_SOURCE_ADDR=MyApp

# Server Configuration
PORT=3000
NODE_ENV=development

# SMPP Advanced Settings
SMPP_WINDOW_SIZE=10
SMPP_ENQUIRE_LINK_INTERVAL_MS=30000
SMPP_ENQUIRE_LINK_TIMEOUT_MS=5000
SMPP_MESSAGE_TIMEOUT_MS=60000
SMPP_RECONNECT_ATTEMPTS=3
SMPP_RECONNECT_DELAY_MS=5000

# Feature Limits
SMPP_MAX_BATCH_SIZE=100
SMPP_MAX_SEGMENTS=10
